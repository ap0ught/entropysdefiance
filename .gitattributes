# Auto detect text files and perform LF normalization
* text=auto

# Declare files that will always have LF line endings on checkout
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.sh text eol=lf
gradlew text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ttf binary
*.otf binary
*.svg binary

# Mark Kotlin files as Kotlin for GitHub linguist
*.kt linguist-language=Kotlin
*.kts linguist-language=Kotlin 